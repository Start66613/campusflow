[
  {
    "start": 0.8,
    "end": 4.499,
    "text": "大学生活，也该有自己的顺滑节奏。"
  },
  {
    "start": 6.5,
    "end": 9.985,
    "text": "CampusFlow，把课表、待办和生活，"
  },
  {
    "start": 9.985,
    "end": 11.479,
    "text": "放进一个校园助手。"
  },
  {
    "start": 12.6,
    "end": 14.808,
    "text": "一整周，一眼看清。"
  },
  {
    "start": 14.808,
    "end": 18.979,
    "text": "长按拖动，快速调整课程；左右滑动，"
  },
  {
    "start": 18.979,
    "end": 20.451,
    "text": "切换每一周。"
  },
  {
    "start": 21.6,
    "end": 24.993,
    "text": "登录湘大教务，导入课表和成绩。"
  },
  {
    "start": 24.993,
    "end": 27.481,
    "text": "也能从表格或截图开始。"
  },
  {
    "start": 28.6,
    "end": 30.52,
    "text": "一句话，记下来。"
  },
  {
    "start": 30.52,
    "end": 35.799,
    "text": "消费、日程、作业，AI帮你整理，核对后写入，"
  },
  {
    "start": 35.799,
    "end": 37.479,
    "text": "还能立即撤销。"
  },
  {
    "start": 38.6,
    "end": 41.227,
    "text": "成绩有口径，方向有依据。"
  },
  {
    "start": 41.227,
    "end": 44.072,
    "text": "必修绩点与选修学分分开看，"
  },
  {
    "start": 44.072,
    "end": 46.48,
    "text": "联网建议附上网页来源。"
  },
  {
    "start": 47.6,
    "end": 50.92,
    "text": "专注二十五分钟，记录每一笔消费，"
  },
  {
    "start": 50.92,
    "end": 53.411,
    "text": "在周报里看见自己的进步。"
  },
  {
    "start": 55.6,
    "end": 58.923,
    "text": "颜色、背景、头像，全都由你。"
  },
  {
    "start": 58.923,
    "end": 60.347,
    "text": "想换个心情？"
  },
  {
    "start": 60.347,
    "end": 62.484,
    "text": "全体嘉豪，往里豪。"
  },
  {
    "start": 63.6,
    "end": 65.771,
    "text": "CampusFlow。"
  },
  {
    "start": 65.771,
    "end": 68.139,
    "text": "你的大学节奏，由你掌握。"
  }
]