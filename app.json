{
  "expo": {
    "name": "CampusFlow",
    "slug": "campusflow",
    "version": "1.0.0",
    "description": "AI 驱动的个人课表、任务、消费与专注助手。",
    "orientation": "portrait",
    "icon": "./assets/images/icon-2026.png",
    "scheme": "campusflow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.start66613.campusflow",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "用于选择头像、应用或课程背景，以及课表和作业图片进行智能识别。",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.start66613.campusflow",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#526DDE",
        "foregroundImage": "./assets/images/android-icon-foreground-2026.png",
        "monochromeImage": "./assets/images/android-icon-foreground-2026.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon-2026.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-calendar",
        {
          "calendarPermission": "允许 CampusFlow 将课程和日程添加到你的日历。",
          "remindersPermission": "允许 CampusFlow 将任务添加到提醒事项。"
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "campus-reminders"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "用于选择头像、应用或课程背景，以及课表和作业图片进行智能识别。"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "./plugins/with-altstore-unsigned"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "88c15ad3-d789-41ae-9c04-e0790890866b"
      }
    },
    "owner": "start66613"
  }
}
